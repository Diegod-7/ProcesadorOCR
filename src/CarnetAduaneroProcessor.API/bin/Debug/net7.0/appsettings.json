{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CarnetAduaneroProcessor;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "AzureFormRecognizer": {
    "Endpoint": "https://your-form-recognizer.cognitiveservices.azure.com/",
    "Key": "your-form-recognizer-key"
  },
  "AzureVision": {
    "Endpoint": "https://procesamiento-documentos-automatico.cognitiveservices.azure.com/",
    "Key": "570d6tsH97yhiA4Ms1c6yN7bNKPcM942Q9re0cMHz9EQXshObgFWJQQJ99BHACZoyfiXJ3w3AAAFACOGtd1f"
  },
  "FileStorage": {
    "MaxFileSizeInMB": 10,
    "AllowedExtensions": [".pdf"],
    "StoragePath": "Uploads"
  },
  "Security": {
    "ApiKey": "your-api-key-here",
    "EnableRateLimiting": true,
    "MaxRequestsPerMinute": 100
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://127.0.0.1:5500",
      "https://127.0.0.1:5500",
      "https://yourdomain.com"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
} 